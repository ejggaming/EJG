# Server Configuration
PORT=3001
NODE_ENV=test

# Dedicated QA / E2E database
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<db-name>?retryWrites=true&w=majority&appName=<app-name>"

JWT_SECRET=QaTestSecretKey12345

# CORS Configuration for local QA runs
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173"
CORS_CREDENTIALS=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Optional email placeholders
SMTP_USER=
APP_PASSWORD=

# Keep QA-created records in betting-db-test after tests (for manual inspection)
QA_KEEP_DATA=true
